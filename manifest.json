{
  "manifest_version": 3,
  "name": "Alelo",
  "version": "0.2.1",
  "description": "Translate selected text in the browser using a local Ollama chat API.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Alelo — translate custom text",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": [
      "constants.js",
      "config.js",
      "language-flags.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "alelo@glaucopater.github.io",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "contextMenus",
    "tabs",
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:11434/*",
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.html", "content.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
